<Project Sdk="Microsoft.NET.Sdk">

  <!--
    BepInEx 6 (IL2CPP) 插件。

    编译前需要:
      1) 游戏已安装 BepInEx 6 (IL2CPP, 需支持该游戏 Unity 版本的构建)
      2) 至少启动过一次游戏, 让 BepInEx 生成 BepInEx\interop\*.dll

    编译:
      dotnet build -c Release -p:GameDir="D:\Path\To\Game"
    或把本仓库放到游戏目录下, 直接 dotnet build -c Release

    产物: bin\Release\LilliaDemosaic.dll → 复制到 <游戏>\BepInEx\plugins\
  -->

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>LilliaDemosaic</AssemblyName>
    <RootNamespace>LilliaDemosaic</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <DebugType>none</DebugType>

    <GameDir Condition="'$(GameDir)' == ''">$(MSBuildThisFileDirectory)..\</GameDir>
    <InteropDir Condition="'$(InteropDir)' == ''">$(GameDir)\BepInEx\interop</InteropDir>
    <CoreDir Condition="'$(CoreDir)' == ''">$(GameDir)\BepInEx\core</CoreDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx.Core">
      <HintPath>$(CoreDir)\BepInEx.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Unity.IL2CPP">
      <HintPath>$(CoreDir)\BepInEx.Unity.IL2CPP.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(CoreDir)\Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- 由 BepInEx 生成的 interop 程序集, 不随插件分发 -->
  <ItemGroup Condition="Exists('$(InteropDir)\UnityEngine.CoreModule.dll')">
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(InteropDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(InteropDir)\Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CheckPrerequisites" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(InteropDir)\UnityEngine.CoreModule.dll')"
           Text="找不到 interop 程序集: $(InteropDir)\UnityEngine.CoreModule.dll 。先安装 BepInEx 6 并启动一次游戏生成它, 或用 -p:GameDir=... 指定游戏目录。" />
    <Error Condition="!Exists('$(CoreDir)\BepInEx.Core.dll')"
           Text="找不到 BepInEx 核心库: $(CoreDir)\BepInEx.Core.dll 。检查 BepInEx 是否已安装。" />
  </Target>

</Project>
